+        if (qemu_chr_fe_read_all(&tpm_emu->data_chr, buf, len) != len) {
+            error_setg(errp, "tpm-emulator: read from data chardev failed");
+            return -1;
+        }
+        return 0;
+    }
+    return qio_channel_read_all(tpm_emu->data_ioc, (char *)buf, len, errp);
+}
