+static int tpm_emulator_data_write(TPMEmulator *tpm_emu, const uint8_t *buf,
+                                   size_t len, Error **errp)
+{
+    if (tpm_emu->use_data_chr) {
+        if (qemu_chr_fe_write_all(&tpm_emu->data_chr, buf, len) != len) {
+            error_setg(errp, "tpm-emulator: write to data chardev failed");
+            return -1;
+        }
+        return 0;
+    }
+    return qio_channel_write_all(tpm_emu->data_ioc, (char *)buf, len, errp);
+}
+
