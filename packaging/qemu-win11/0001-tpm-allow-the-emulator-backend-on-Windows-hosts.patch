+/*
+ * Probe the TPM version over the data channel (TPM2 ReadClock, then a
+ * TPM 1.2 GetTicks), like tpm_util_test_tpmdev() but through the
+ * emulator's own transport.
+ */
+static int tpm_emulator_probe_version(TPMEmulator *tpm_emu)
+{
+    static const uint8_t tpm2_req[] = {
+        0x80, 0x01, 0x00, 0x00, 0x00, 0x0a, 0x00, 0x00, 0x01, 0x81
+    }; /* TPM2_ST_NO_SESSIONS, len 10, TPM2_CC_ReadClock */
+    static const uint8_t tpm12_req[] = {
+        0x00, 0xc1, 0x00, 0x00, 0x00, 0x0a, 0x00, 0x00, 0x00, 0xf1
+    }; /* TPM_TAG_RQU_COMMAND, len 10, TPM_ORD_GetTicks */
+    uint8_t out[4096];
+    Error *err = NULL;
+
+    if (tpm_emulator_unix_tx_bufs(tpm_emu, tpm2_req, sizeof(tpm2_req),
+                                  out, sizeof(out), NULL, &err) == 0 &&
+        tpm_cmd_get_tag(out) == 0x8001) {
+        tpm_emu->tpm_version = TPM_VERSION_2_0;
+        return 0;
+    }
+    error_free(err);
+    err = NULL;
+    if (tpm_emulator_unix_tx_bufs(tpm_emu, tpm12_req, sizeof(tpm12_req),
+                                  out, sizeof(out), NULL, &err) == 0 &&
+        tpm_cmd_get_tag(out) == 0x00c4) {
+        tpm_emu->tpm_version = TPM_VERSION_1_2;
+        return 0;
+    }
+    error_free(err);
+    return -1;
 }
 
