<!--
  Windows Sandbox configuration for the LightVM clean-machine test (F2).
  Generated by packaging/windows/build-package.ps1 into dist/ with the real
  path of the dist folder. The dist folder is mapped READ-ONLY; networking
  and clipboard redirection are disabled. At logon, sandbox-test.ps1 checks
  the zip's SHA-256, installs LightVM per user, runs a timed start and stop, and
  writes LightVM-sandbox-report.txt on the sandbox desktop.
  Limits: Windows Sandbox has no nested virtualization (no WHPX) and no QEMU,
  so VMs cannot be started inside it. Requires Windows 11 Pro/Enterprise with
  the "Windows Sandbox" optional feature enabled.
-->
<Configuration>
  <VGpu>Default</VGpu>
  <Networking>Disable</Networking>
  <ClipboardRedirection>Disable</ClipboardRedirection>
  <PrinterRedirection>Disable</PrinterRedirection>
  <AudioInput>Disable</AudioInput>
  <VideoInput>Disable</VideoInput>
  <MappedFolders>
    <MappedFolder>
      <HostFolder>@DIST_DIR@</HostFolder>
      <SandboxFolder>C:\Users\WDAGUtilityAccount\Desktop\dist</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
  </MappedFolders>
  <LogonCommand>
    <Command>powershell.exe -NoProfile -ExecutionPolicy Bypass -File C:\Users\WDAGUtilityAccount\Desktop\dist\sandbox-test.ps1 @TEST_ARGS@</Command>
  </LogonCommand>
</Configuration>
