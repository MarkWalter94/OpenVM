{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Screenshot",
  "description": "Metadata of a screenshot produced by the backend (ROADMAP 6.4, 9). The image\nbytes travel separately (MCP image content or IPC block),\nnever as a host path.",
  "type": "object",
  "properties": {
    "byte_len": {
      "description": "Size in bytes of the image.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "captured_at": {
      "description": "Capture instant.",
      "$ref": "#/$defs/UtcTimestamp"
    },
    "format": {
      "description": "Format.",
      "$ref": "#/$defs/ImageFormat"
    },
    "geometry": {
      "description": "Display geometry at capture time.",
      "$ref": "#/$defs/DisplayGeometry"
    },
    "run_id": {
      "description": "Run in which it was captured.",
      "$ref": "#/$defs/RunId"
    },
    "sha256": {
      "description": "SHA-256 of the image bytes.",
      "$ref": "#/$defs/Sha256Digest"
    },
    "vm_id": {
      "description": "VM.",
      "$ref": "#/$defs/VmId"
    }
  },
  "required": [
    "vm_id",
    "run_id",
    "geometry",
    "format",
    "sha256",
    "byte_len",
    "captured_at"
  ],
  "$defs": {
    "DisplayGeometry": {
      "description": "Guest display geometry in pixels.",
      "type": "object",
      "properties": {
        "height": {
          "description": "Height (1..=8192).",
          "type": "integer",
          "format": "uint32",
          "maximum": 8192,
          "minimum": 1
        },
        "width": {
          "description": "Width (1..=8192).",
          "type": "integer",
          "format": "uint32",
          "maximum": 8192,
          "minimum": 1
        }
      },
      "required": [
        "width",
        "height"
      ]
    },
    "ImageFormat": {
      "description": "Image format of a screenshot.",
      "oneOf": [
        {
          "description": "PNG.",
          "type": "string",
          "const": "png"
        }
      ]
    },
    "RunId": {
      "description": "RunId: version 7 UUID, lowercase with hyphens.",
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "Sha256Digest": {
      "description": "SHA-256 in lowercase hexadecimal.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "UtcTimestamp": {
      "description": "RFC 3339 UTC instant with Z suffix, millisecond precision.",
      "type": "string",
      "format": "date-time"
    },
    "VmId": {
      "description": "VmId: version 7 UUID, lowercase with hyphens.",
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
