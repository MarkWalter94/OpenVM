{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Screenshot",
  "description": "Metadati di uno screenshot prodotto dal backend (ROADMAP 6.4, 9). I byte\ndell'immagine viaggiano separatamente (contenuto immagine MCP o blocco IPC),\nmai come percorso host.",
  "type": "object",
  "properties": {
    "byte_len": {
      "description": "Dimensione in byte dell'immagine.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "captured_at": {
      "description": "Istante della cattura.",
      "$ref": "#/$defs/UtcTimestamp"
    },
    "format": {
      "description": "Formato.",
      "$ref": "#/$defs/ImageFormat"
    },
    "geometry": {
      "description": "Geometria del display al momento della cattura.",
      "$ref": "#/$defs/DisplayGeometry"
    },
    "run_id": {
      "description": "Esecuzione in cui è stato catturato.",
      "$ref": "#/$defs/RunId"
    },
    "sha256": {
      "description": "SHA-256 dei byte dell'immagine.",
      "$ref": "#/$defs/Sha256Digest"
    },
    "vm_id": {
      "description": "VM.",
      "$ref": "#/$defs/VmId"
    }
  },
  "required": [
    "vm_id",
    "run_id",
    "geometry",
    "format",
    "sha256",
    "byte_len",
    "captured_at"
  ],
  "$defs": {
    "DisplayGeometry": {
      "description": "Geometria del display guest in pixel.",
      "type": "object",
      "properties": {
        "height": {
          "description": "Altezza (1..=8192).",
          "type": "integer",
          "format": "uint32",
          "maximum": 8192,
          "minimum": 1
        },
        "width": {
          "description": "Larghezza (1..=8192).",
          "type": "integer",
          "format": "uint32",
          "maximum": 8192,
          "minimum": 1
        }
      },
      "required": [
        "width",
        "height"
      ]
    },
    "ImageFormat": {
      "description": "Formato dell'immagine di uno screenshot.",
      "oneOf": [
        {
          "description": "PNG.",
          "type": "string",
          "const": "png"
        }
      ]
    },
    "RunId": {
      "description": "RunId: UUID versione 7 in minuscolo con trattini.",
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "Sha256Digest": {
      "description": "SHA-256 in esadecimale minuscolo.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "UtcTimestamp": {
      "description": "Istante UTC RFC 3339 con suffisso Z, precisione al millisecondo.",
      "type": "string",
      "format": "date-time"
    },
    "VmId": {
      "description": "VmId: UUID versione 7 in minuscolo con trattini.",
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
