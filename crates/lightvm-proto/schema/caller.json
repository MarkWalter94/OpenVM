{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Caller",
  "description": "Who requests an action.",
  "oneOf": [
    {
      "description": "Local user through the UI (subject to global limits, VM policy and host capacity).",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "user"
        }
      },
      "required": [
        "kind"
      ]
    },
    {
      "description": "Agent with a session: also subject to the grant. The token is checked on every\ncall and right before forwarding.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "agent"
        },
        "session_id": {
          "description": "Declared session.",
          "$ref": "#/$defs/SessionId"
        },
        "token": {
          "description": "Session secret; missing = `unauthenticated` denial.",
          "anyOf": [
            {
              "$ref": "#/$defs/SessionToken"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "session_id"
      ]
    }
  ],
  "$defs": {
    "SessionId": {
      "description": "SessionId: version 7 UUID, lowercase with hyphens.",
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "SessionToken": {
      "description": "Session secret, only on authenticated IPC; never in logs or reports.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "writeOnly": true
    }
  }
}
