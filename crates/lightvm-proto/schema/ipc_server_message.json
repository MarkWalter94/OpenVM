{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ServerMessage",
  "description": "Messages from the service to the client.",
  "oneOf": [
    {
      "description": "Handshake accepted.",
      "type": "object",
      "properties": {
        "connection_id": {
          "description": "Identifier assigned to the connection.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "protocol_version": {
          "description": "Negotiated version.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "request_id": {
          "description": "Request of `hello`.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "role": {
          "description": "Role of the credential.",
          "$ref": "#/$defs/Role"
        },
        "type": {
          "type": "string",
          "const": "hello_ok"
        }
      },
      "required": [
        "type",
        "request_id",
        "protocol_version",
        "connection_id",
        "role"
      ]
    },
    {
      "description": "Positive response.",
      "type": "object",
      "properties": {
        "request_id": {
          "description": "Request.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "result": {
          "description": "Result.",
          "$ref": "#/$defs/ResponseBody"
        },
        "type": {
          "type": "string",
          "const": "response"
        }
      },
      "required": [
        "type",
        "request_id",
        "result"
      ]
    },
    {
      "description": "Error; `request_id` absent if the frame was not decodable.",
      "type": "object",
      "properties": {
        "error": {
          "description": "Error.",
          "$ref": "#/$defs/ReplyError"
        },
        "request_id": {
          "description": "Request, if known.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "type": {
          "type": "string",
          "const": "error"
        }
      },
      "required": [
        "type",
        "error"
      ]
    },
    {
      "description": "State event (after `subscribe`).",
      "type": "object",
      "properties": {
        "event": {
          "description": "Event.",
          "$ref": "#/$defs/ServiceEvent"
        },
        "type": {
          "type": "string",
          "const": "event"
        }
      },
      "required": [
        "type",
        "event"
      ]
    },
    {
      "description": "Close initiated by the service; the transport close follows.",
      "type": "object",
      "properties": {
        "reason": {
          "description": "Reason.",
          "$ref": "#/$defs/CloseReason"
        },
        "type": {
          "type": "string",
          "const": "closing"
        }
      },
      "required": [
        "type",
        "reason"
      ]
    }
  ],
  "$defs": {
    "Admission": {
      "description": "Outcome of accepting a request (before forwarding).",
      "type": "object",
      "properties": {
        "duplicate": {
          "description": "`true` if the request repeats an already known `operation_id` (no new effect).",
          "type": "boolean"
        },
        "operation_id": {
          "description": "Operation.",
          "$ref": "#/$defs/OperationId"
        },
        "status": {
          "description": "Current status of the operation.",
          "$ref": "#/$defs/OperationStatus"
        }
      },
      "required": [
        "operation_id",
        "status",
        "duplicate"
      ]
    },
    "Capabilities": {
      "description": "Capabilities reported by `get_capabilities`.",
      "type": "object",
      "properties": {
        "accelerator": {
          "description": "Available accelerator, if detected.",
          "type": [
            "string",
            "null"
          ]
        },
        "backend": {
          "description": "Backend name.",
          "type": "string"
        },
        "max_frame_bytes": {
          "description": "Byte limit per frame.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "parent_loss_policy": {
          "description": "Active policy on UI loss.",
          "$ref": "#/$defs/ParentLossPolicy",
          "default": {
            "kind": "kill_vms"
          }
        },
        "protocol_versions": {
          "description": "Supported protocol versions.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        }
      },
      "required": [
        "protocol_versions",
        "backend",
        "max_frame_bytes"
      ]
    },
    "CloseReason": {
      "description": "Reason the service closed the connection.",
      "oneOf": [
        {
          "description": "Connection or credential revoked.",
          "type": "string",
          "const": "revoked"
        },
        {
          "description": "Service shutting down.",
          "type": "string",
          "const": "service_stopping"
        }
      ]
    },
    "ConnectionInfo": {
      "description": "Active connection, for `list_connections`.",
      "type": "object",
      "properties": {
        "client_name": {
          "description": "Name declared by the client, diagnostic only.",
          "type": [
            "string",
            "null"
          ]
        },
        "connection_id": {
          "description": "Connection identifier.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "peer_pid": {
          "description": "Peer PID reported by the operating system, diagnostic only.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "role": {
          "description": "Role of the credential.",
          "$ref": "#/$defs/Role"
        }
      },
      "required": [
        "connection_id",
        "role"
      ]
    },
    "EmergencyStopReport": {
      "description": "Outcome of the Emergency Stop reported to the client.",
      "type": "object",
      "properties": {
        "completed": {
          "description": "True only if the end of all processes was observed.",
          "type": "boolean"
        },
        "processes_terminated": {
          "description": "Processes whose end the backend observed.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "revoked_connections": {
          "description": "Non-UI connections revoked.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "revoked_connections",
        "processes_terminated",
        "completed"
      ]
    },
    "ErrorCode": {
      "description": "Stable code of an operational error. Serialized names never change;\nnew codes are only ever added.",
      "oneOf": [
        {
          "description": "Caller identified (valid credential) but not authorized for the action:\nVM outside the allowlist, missing capability, paused session, insufficient\nrole. Missing or invalid credentials: [`ErrorCode::Unauthenticated`].",
          "type": "string",
          "const": "permission_denied"
        },
        {
          "description": "Session or lease expired: a new authorization in the app is needed.",
          "type": "string",
          "const": "session_expired"
        },
        {
          "description": "Another mutation is in progress or queued on the same VM: retryable.",
          "type": "string",
          "const": "vm_busy"
        },
        {
          "description": "Capability not available on this host, build or phase.",
          "type": "string",
          "const": "unsupported"
        },
        {
          "description": "The action is not allowed in the current state (or refers to a superseded `run_id`).",
          "type": "string",
          "const": "state_conflict"
        },
        {
          "description": "Resource, quota or size limit exceeded.",
          "type": "string",
          "const": "resource_limit"
        },
        {
          "description": "Invalid argument (format, range, name, rejected path).",
          "type": "string",
          "const": "invalid_argument"
        },
        {
          "description": "Object does not exist or is not visible to the caller.",
          "type": "string",
          "const": "not_found"
        },
        {
          "description": "Infrastructure failure (QEMU, QMP, storage, OS) not attributable to the caller.",
          "type": "string",
          "const": "infrastructure_error"
        },
        {
          "description": "No valid credential: IPC credential or session token missing,\nmalformed, unknown, revoked or reused after a supervisor restart.\nA new authorization in the app is needed. Appended after the first nine\ncodes, which remain unchanged.",
          "type": "string",
          "const": "unauthenticated"
        }
      ]
    },
    "Firmware": {
      "description": "Guest firmware. In the MVP only UEFI with managed NVRAM state (ROADMAP 8).",
      "oneOf": [
        {
          "description": "UEFI (OVMF) with per-VM NVRAM.",
          "type": "string",
          "const": "uefi"
        }
      ]
    },
    "GuestOs": {
      "description": "Declared guest operating system. In the MVP the reference is Ubuntu LTS\nx86_64 with the version and checksum pinned in F0 (ROADMAP 4).",
      "oneOf": [
        {
          "description": "Ubuntu LTS x86_64 (MVP reference guest).",
          "type": "string",
          "const": "ubuntu_lts_x86_64"
        },
        {
          "description": "Other Linux x86_64: manageable manually, without compatibility guarantees.",
          "type": "string",
          "const": "other_linux_x86_64"
        }
      ]
    },
    "MediaId": {
      "description": "MediaId: version 7 UUID, lowercase with hyphens.",
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "NetworkProfile": {
      "description": "Network profile. In the MVP the only allowed value is `offline` (ADR-0004): no\nguest NIC, default network devices excluded, no forwarding.",
      "oneOf": [
        {
          "description": "No NIC.",
          "type": "string",
          "const": "offline"
        }
      ]
    },
    "OperationId": {
      "description": "OperationId: version 7 UUID, lowercase with hyphens.",
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "OperationKind": {
      "description": "Kind of operation of the per-VM queue.",
      "oneOf": [
        {
          "description": "Creation of the VM in the catalog.",
          "type": "string",
          "const": "create"
        },
        {
          "description": "Start.",
          "type": "string",
          "const": "start"
        },
        {
          "description": "Ordinary stop.",
          "type": "string",
          "const": "stop"
        },
        {
          "description": "Forced stop.",
          "type": "string",
          "const": "force_stop"
        },
        {
          "description": "Guest reset.",
          "type": "string",
          "const": "reset"
        },
        {
          "description": "Screen capture.",
          "type": "string",
          "const": "screenshot"
        },
        {
          "description": "Typed input.",
          "type": "string",
          "const": "input"
        },
        {
          "description": "Checkpoint with the VM off (from F3).",
          "type": "string",
          "const": "snapshot"
        },
        {
          "description": "Restore of a baseline with the VM off (from F3).",
          "type": "string",
          "const": "restore"
        },
        {
          "description": "Emergency Stop (priority path, outside the queue).",
          "type": "string",
          "const": "emergency_stop"
        }
      ]
    },
    "OperationRecord": {
      "description": "Record of an operation (queryable by `operation_id`).",
      "type": "object",
      "properties": {
        "error": {
          "description": "Error code if `failed` or `discarded`.",
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorCode"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "description": "Identifier (idempotency key).",
          "$ref": "#/$defs/OperationId"
        },
        "kind": {
          "description": "Kind.",
          "$ref": "#/$defs/OperationKind"
        },
        "requested_at": {
          "description": "Acceptance instant.",
          "$ref": "#/$defs/UtcTimestamp"
        },
        "run_id": {
          "description": "Run it refers to, if relevant.",
          "anyOf": [
            {
              "$ref": "#/$defs/RunId"
            },
            {
              "type": "null"
            }
          ]
        },
        "session_id": {
          "description": "Requesting session, if an agent.",
          "anyOf": [
            {
              "$ref": "#/$defs/SessionId"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "description": "Status.",
          "$ref": "#/$defs/OperationStatus"
        },
        "updated_at": {
          "description": "Instant of the last status change.",
          "$ref": "#/$defs/UtcTimestamp"
        },
        "vm_id": {
          "description": "VM.",
          "$ref": "#/$defs/VmId"
        }
      },
      "required": [
        "id",
        "vm_id",
        "kind",
        "status",
        "requested_at",
        "updated_at"
      ]
    },
    "OperationStatus": {
      "description": "Status of an operation.",
      "oneOf": [
        {
          "description": "Accepted, queued, not yet forwarded to the backend.",
          "type": "string",
          "const": "queued"
        },
        {
          "description": "Forwarded to the backend: it may produce effects even after a revocation.",
          "type": "string",
          "const": "forwarded"
        },
        {
          "description": "Completed successfully.",
          "type": "string",
          "const": "succeeded"
        },
        {
          "description": "Forwarded and failed.",
          "type": "string",
          "const": "failed"
        },
        {
          "description": "Discarded before forwarding (revocation, Emergency Stop, superseded `run_id`): no effect.",
          "type": "string",
          "const": "discarded"
        }
      ]
    },
    "ParentLossPolicy": {
      "description": "Fate of the VMs when the UI that started the service ends without a\ncontrolled shutdown (crash, forced termination). ADR-0015 part B.",
      "oneOf": [
        {
          "description": "Emergency Stop of all VMs, then shutdown of the service (default).",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "kill_vms"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "description": "Orderly (ACPI) shutdown with a bounded wait, then `quit` and\ntermination; finally shutdown of the service.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "shutdown_vms"
            },
            "powerdown_s": {
              "description": "Wait for the ACPI shutdown per VM, in seconds\n([`MIN_PARENT_LOSS_POWERDOWN_S`]..=[`MAX_PARENT_LOSS_POWERDOWN_S`]).",
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "powerdown_s"
          ]
        },
        {
          "description": "The VMs stay on and the service stays active without a UI.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "keep_vms"
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "ProtocolError": {
      "description": "Protocol error: distinct from operational errors (ROADMAP 9).",
      "type": "object",
      "properties": {
        "code": {
          "description": "Stable code.",
          "$ref": "#/$defs/ProtocolErrorCode"
        },
        "message": {
          "description": "Message for humans, without secrets.",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ]
    },
    "ProtocolErrorCode": {
      "description": "Code of a protocol error (request not understood, no effect attempted).",
      "oneOf": [
        {
          "description": "Message not decodable or not conforming to the schema.",
          "type": "string",
          "const": "malformed_message"
        },
        {
          "description": "Unsupported protocol version.",
          "type": "string",
          "const": "unsupported_version"
        },
        {
          "description": "Unknown method or request type.",
          "type": "string",
          "const": "unknown_method"
        },
        {
          "description": "Message exceeds the maximum allowed size.",
          "type": "string",
          "const": "message_too_large"
        },
        {
          "description": "Kept for contract compatibility but **not emitted**: a missing or invalid\ncredential produces the operational error [`ErrorCode::Unauthenticated`]\n(see the module documentation).",
          "type": "string",
          "const": "unauthenticated"
        }
      ]
    },
    "PublicError": {
      "description": "Public operational error.\n\nJSON shape: `{\"code\": \"...\", \"message\": \"...\", \"details\": {..}?, \"retryable\": bool}`.",
      "type": "object",
      "properties": {
        "code": {
          "description": "Stable code.",
          "$ref": "#/$defs/ErrorCode"
        },
        "details": {
          "description": "Optional structured details (textual keys and values, without secrets).",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "string"
          }
        },
        "message": {
          "description": "Message for humans, without secrets or host paths.",
          "type": "string"
        },
        "retryable": {
          "description": "`true` if retrying the same idempotent request may succeed.",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ]
    },
    "ReplyError": {
      "description": "Reply error: either operational or protocol, never mixed up.\n\nJSON shape: `{\"kind\": \"operational\", ...PublicError}` or\n`{\"kind\": \"protocol\", ...ProtocolError}`.",
      "oneOf": [
        {
          "description": "Request understood but rejected or failed.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "operational"
            }
          },
          "$ref": "#/$defs/PublicError",
          "required": [
            "kind"
          ]
        },
        {
          "description": "Request not understood: no effect attempted.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "protocol"
            }
          },
          "$ref": "#/$defs/ProtocolError",
          "required": [
            "kind"
          ]
        }
      ]
    },
    "ResponseBody": {
      "description": "Results of the operations.",
      "oneOf": [
        {
          "description": "Response to `ping`.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "pong"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "description": "Response to `get_capabilities`.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "capabilities"
            }
          },
          "$ref": "#/$defs/Capabilities",
          "required": [
            "kind"
          ]
        },
        {
          "description": "Response to `list_vms`.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "vm_list"
            },
            "vms": {
              "description": "Visible VMs.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/VmSummary"
              }
            }
          },
          "required": [
            "kind",
            "vms"
          ]
        },
        {
          "description": "Response to `vm_status`.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "vm"
            },
            "vm": {
              "description": "Status of the VM.",
              "$ref": "#/$defs/VmSummary"
            }
          },
          "required": [
            "kind",
            "vm"
          ]
        },
        {
          "description": "Response to `create_vm`.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "vm_created"
            },
            "vm": {
              "description": "Created VM, with identifier assigned by the core.",
              "$ref": "#/$defs/VmRecord"
            }
          },
          "required": [
            "kind",
            "vm"
          ]
        },
        {
          "description": "Response to `update_vm`: VM with the new revision.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "vm_updated"
            },
            "vm": {
              "description": "Updated VM.",
              "$ref": "#/$defs/VmRecord"
            }
          },
          "required": [
            "kind",
            "vm"
          ]
        },
        {
          "description": "Response to `submit_vm`: acceptance and recorded outcome.",
          "type": "object",
          "properties": {
            "admission": {
              "description": "Acceptance (or idempotent duplicate).",
              "$ref": "#/$defs/Admission"
            },
            "kind": {
              "type": "string",
              "const": "operation"
            },
            "operation": {
              "description": "Record of the operation after execution, if available.",
              "anyOf": [
                {
                  "$ref": "#/$defs/OperationRecord"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "admission"
          ]
        },
        {
          "description": "Subscription accepted.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "subscribed"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "description": "Response to `list_connections`.",
          "type": "object",
          "properties": {
            "connections": {
              "description": "Active connections.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/ConnectionInfo"
              }
            },
            "kind": {
              "type": "string",
              "const": "connections"
            }
          },
          "required": [
            "kind",
            "connections"
          ]
        },
        {
          "description": "Connection revoked.",
          "type": "object",
          "properties": {
            "connection_id": {
              "description": "Revoked connection.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "revoked"
            }
          },
          "required": [
            "kind",
            "connection_id"
          ]
        },
        {
          "description": "Pairing credential issued: it must be delivered out of band, never recorded.",
          "type": "object",
          "properties": {
            "credential": {
              "description": "Credential in hexadecimal.",
              "type": "string",
              "writeOnly": true
            },
            "expires_in_s": {
              "description": "Expiry in seconds.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "pairing_credential"
            }
          },
          "required": [
            "kind",
            "credential",
            "expires_in_s"
          ]
        },
        {
          "description": "Outcome of the Emergency Stop.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "emergency_stop"
            }
          },
          "$ref": "#/$defs/EmergencyStopReport",
          "required": [
            "kind"
          ]
        },
        {
          "description": "UI loss policy in force after `set_parent_loss_policy`.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "parent_loss_policy"
            },
            "policy": {
              "description": "Active policy.",
              "$ref": "#/$defs/ParentLossPolicy"
            }
          },
          "required": [
            "kind",
            "policy"
          ]
        },
        {
          "description": "Shutdown accepted.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "shutting_down"
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "Role": {
      "description": "Role associated with the channel credential.\n\n`ui` corresponds to [`crate::Caller::User`] towards the core; `pairing` does not\ngrant permissions on VMs (ADR-0006): the agent session grant arrives\nin F4 ([`crate::Grant`], [`crate::SessionToken`]).",
      "oneOf": [
        {
          "description": "Desktop interface that started the service.",
          "type": "string",
          "const": "ui"
        },
        {
          "description": "Client waiting for pairing (MCP adapter): no VM permissions.",
          "type": "string",
          "const": "pairing"
        }
      ]
    },
    "RunId": {
      "description": "RunId: version 7 UUID, lowercase with hyphens.",
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "ServiceEvent": {
      "description": "Events published on the state channel.",
      "oneOf": [
        {
          "description": "Change of the service state.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "service_state"
            },
            "state": {
              "description": "New state.",
              "$ref": "#/$defs/ServiceState"
            }
          },
          "required": [
            "kind",
            "state"
          ]
        },
        {
          "description": "Change of a VM's state.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "vm_state"
            },
            "state": {
              "description": "New state.",
              "$ref": "#/$defs/VmState"
            },
            "vm_id": {
              "description": "VM.",
              "$ref": "#/$defs/VmId"
            }
          },
          "required": [
            "kind",
            "vm_id",
            "state"
          ]
        },
        {
          "description": "A connection was revoked.",
          "type": "object",
          "properties": {
            "connection_id": {
              "description": "Revoked connection.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "connection_revoked"
            }
          },
          "required": [
            "kind",
            "connection_id"
          ]
        },
        {
          "description": "The agent sessions were stopped.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "agent_sessions_stopped"
            },
            "reason": {
              "description": "Reason.",
              "$ref": "#/$defs/StopReason"
            }
          },
          "required": [
            "kind",
            "reason"
          ]
        },
        {
          "description": "Events lost because the client was too slow.",
          "type": "object",
          "properties": {
            "count": {
              "description": "Number of lost events.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "const": "events_lost"
            }
          },
          "required": [
            "kind",
            "count"
          ]
        }
      ]
    },
    "ServiceState": {
      "description": "State of the service.",
      "oneOf": [
        {
          "description": "In service.",
          "type": "string",
          "const": "running"
        },
        {
          "description": "Controlled shutdown in progress.",
          "type": "string",
          "const": "stopping"
        }
      ]
    },
    "SessionId": {
      "description": "SessionId: version 7 UUID, lowercase with hyphens.",
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "StopReason": {
      "description": "Reason the agent sessions were stopped.",
      "oneOf": [
        {
          "description": "Parent process (UI) terminated.",
          "type": "string",
          "const": "parent_lost"
        },
        {
          "description": "Emergency Stop.",
          "type": "string",
          "const": "emergency_stop"
        },
        {
          "description": "Controlled shutdown of the service.",
          "type": "string",
          "const": "shutdown"
        }
      ]
    },
    "UtcTimestamp": {
      "description": "RFC 3339 UTC instant with Z suffix, millisecond precision.",
      "type": "string",
      "format": "date-time"
    },
    "VmConfig": {
      "description": "VM configuration requested by the user. No field is a path or\na QEMU option: media are referenced by [`MediaId`] of the approved registry.",
      "type": "object",
      "properties": {
        "data_media": {
          "description": "Optional read-only data media (kind `data_iso`), attached with the VM off.",
          "anyOf": [
            {
              "$ref": "#/$defs/MediaId"
            },
            {
              "type": "null"
            }
          ]
        },
        "disk_gib": {
          "description": "Virtual size of the main QCOW2 disk in GiB.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "firmware": {
          "description": "Firmware; in the MVP only `uefi`.",
          "$ref": "#/$defs/Firmware",
          "default": "uefi"
        },
        "guest_os": {
          "description": "Declared guest operating system.",
          "$ref": "#/$defs/GuestOs"
        },
        "install_media": {
          "description": "Installation media from the media registry (kind `install_iso`).",
          "anyOf": [
            {
              "$ref": "#/$defs/MediaId"
            },
            {
              "type": "null"
            }
          ]
        },
        "limits": {
          "description": "Execution limits applied by the supervisor to the QEMU process\n(ADR-0017); missing in older catalogs → default values.",
          "$ref": "#/$defs/VmLimits",
          "default": {
            "cpu_max_percent": 100,
            "memory_margin_mib": 1024
          }
        },
        "memory_mib": {
          "description": "Guest memory in MiB (not the limit of the whole QEMU process).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "name": {
          "description": "Visible name.",
          "$ref": "#/$defs/VmName"
        },
        "network": {
          "description": "Network profile; in the MVP only `offline`.",
          "$ref": "#/$defs/NetworkProfile",
          "default": "offline"
        },
        "vcpus": {
          "description": "Number of vCPUs (not a CPU percentage limit: ROADMAP 7.2).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "guest_os",
        "vcpus",
        "memory_mib",
        "disk_gib"
      ]
    },
    "VmId": {
      "description": "VmId: version 7 UUID, lowercase with hyphens.",
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "VmLimits": {
      "description": "Execution limits of a VM (ADR-0017), set by the user in the\nVM settings and applied by the supervisor, never by the client.",
      "type": "object",
      "properties": {
        "cpu_max_percent": {
          "description": "CPU cap as a percentage of the capacity of the assigned vCPUs\n([`MIN_CPU_MAX_PERCENT`]..=100; 100 = no cap). Applied by the\noperating system to the whole QEMU process.",
          "type": "integer",
          "format": "uint8",
          "default": 100,
          "maximum": 255,
          "minimum": 0
        },
        "memory_margin_mib": {
          "description": "Memory granted to the QEMU process beyond the guest RAM, in MiB\n([`MIN_MEMORY_MARGIN_MIB`]..=[`MAX_MEMORY_MARGIN_MIB`]). When the\nlimit is exceeded, QEMU is terminated and the exit is classified as a resource limit.",
          "type": "integer",
          "format": "uint32",
          "default": 1024,
          "minimum": 0
        },
        "storage_budget_gib": {
          "description": "Maximum space in GiB for the VM's files beyond the main disk\n(overlays, baselines, firmware variables); `None` = no dedicated budget.\nChecked at every start.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "VmName": {
      "description": "VM name: ASCII label, not a path.",
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9 ._-]*$"
    },
    "VmRecord": {
      "description": "Catalog VM with configuration revision and last persisted state.",
      "type": "object",
      "properties": {
        "config": {
          "description": "Current configuration.",
          "$ref": "#/$defs/VmConfig"
        },
        "config_revision": {
          "description": "Configuration revision, incremented on every change (revision check).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "created_at": {
          "description": "Creation instant.",
          "$ref": "#/$defs/UtcTimestamp"
        },
        "id": {
          "description": "Identifier.",
          "$ref": "#/$defs/VmId"
        },
        "persisted_state": {
          "description": "Last persisted state: a hint, the observed state takes precedence.",
          "$ref": "#/$defs/VmState"
        }
      },
      "required": [
        "id",
        "config",
        "config_revision",
        "persisted_state",
        "created_at"
      ]
    },
    "VmState": {
      "description": "Lifecycle state of a VM.",
      "oneOf": [
        {
          "description": "Process absent and files released. The only state for operations on disks, NVRAM and media.",
          "type": "string",
          "const": "stopped"
        },
        {
          "description": "Spawn started, new `run_id` assigned, QMP not ready yet.",
          "type": "string",
          "const": "starting"
        },
        {
          "description": "Process alive and QMP ready.",
          "type": "string",
          "const": "running"
        },
        {
          "description": "Stop requested; complete only once the process end is observed.",
          "type": "string",
          "const": "stopping"
        },
        {
          "description": "Start error or unexpected exit. No automatic promotion to baseline.",
          "type": "string",
          "const": "failed"
        },
        {
          "description": "Reconciliation after a crash (journal, files, processes): no external mutation.",
          "type": "string",
          "const": "recovering"
        }
      ]
    },
    "VmSummary": {
      "description": "Summary of a VM for list and status.",
      "type": "object",
      "properties": {
        "config": {
          "description": "Current configuration (resources and limits), for the VM settings.",
          "$ref": "#/$defs/VmConfig"
        },
        "config_revision": {
          "description": "Configuration revision, to be given in `update_vm`.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "name": {
          "description": "Displayed name.",
          "$ref": "#/$defs/VmName"
        },
        "run_id": {
          "description": "Current run, if a process exists, or the last finished one.",
          "anyOf": [
            {
              "$ref": "#/$defs/RunId"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "description": "Current state as seen by the core (derived from the process and QMP).",
          "$ref": "#/$defs/VmState"
        },
        "vm_id": {
          "description": "VM.",
          "$ref": "#/$defs/VmId"
        }
      },
      "required": [
        "vm_id",
        "name",
        "state",
        "config",
        "config_revision"
      ]
    }
  }
}
