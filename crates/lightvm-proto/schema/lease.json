{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lease",
  "description": "Lease of a session: it must be renewed before it expires, otherwise the\nsession is revoked through the emergency path (ROADMAP 7.3).",
  "type": "object",
  "properties": {
    "expires_at": {
      "description": "Expiry: `renewed_at + duration`, with duration in `1..=LEASE_MAX_MILLIS`.",
      "$ref": "#/$defs/UtcTimestamp"
    },
    "renewed_at": {
      "description": "Last valid renewal.",
      "$ref": "#/$defs/UtcTimestamp"
    },
    "session_id": {
      "description": "Session.",
      "$ref": "#/$defs/SessionId"
    }
  },
  "required": [
    "session_id",
    "renewed_at",
    "expires_at"
  ],
  "$defs": {
    "SessionId": {
      "description": "SessionId: version 7 UUID, lowercase with hyphens.",
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "UtcTimestamp": {
      "description": "RFC 3339 UTC instant with Z suffix, millisecond precision.",
      "type": "string",
      "format": "date-time"
    }
  }
}
