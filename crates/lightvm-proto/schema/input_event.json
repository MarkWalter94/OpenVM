{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InputEvent",
  "description": "Elementary input event.",
  "oneOf": [
    {
      "description": "Key.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "key"
        }
      },
      "$ref": "#/$defs/KeyAction",
      "required": [
        "type"
      ]
    },
    {
      "description": "Absolute movement.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "pointer_move"
        }
      },
      "$ref": "#/$defs/PointerMove",
      "required": [
        "type"
      ]
    },
    {
      "description": "Button.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "pointer_button"
        }
      },
      "$ref": "#/$defs/PointerButton",
      "required": [
        "type"
      ]
    }
  ],
  "$defs": {
    "KeyAction": {
      "description": "Press or release of a key.",
      "type": "object",
      "properties": {
        "down": {
          "description": "`true` = pressed, `false` = released.",
          "type": "boolean"
        },
        "qcode": {
          "description": "QEMU key.",
          "$ref": "#/$defs/QCode"
        }
      },
      "required": [
        "qcode",
        "down"
      ]
    },
    "MouseButton": {
      "description": "Pointer button (allowed QMP `InputButton` names).",
      "oneOf": [
        {
          "description": "Left.",
          "type": "string",
          "const": "left"
        },
        {
          "description": "Middle.",
          "type": "string",
          "const": "middle"
        },
        {
          "description": "Right.",
          "type": "string",
          "const": "right"
        },
        {
          "description": "Wheel up.",
          "type": "string",
          "const": "wheel_up"
        },
        {
          "description": "Wheel down.",
          "type": "string",
          "const": "wheel_down"
        }
      ]
    },
    "PointerButton": {
      "description": "Press or release of a pointer button.",
      "type": "object",
      "properties": {
        "button": {
          "description": "Button.",
          "$ref": "#/$defs/MouseButton"
        },
        "down": {
          "description": "`true` = pressed, `false` = released.",
          "type": "boolean"
        }
      },
      "required": [
        "button",
        "down"
      ]
    },
    "PointerMove": {
      "description": "Absolute pointer movement in QEMU coordinates 0..=32767 on each axis.",
      "type": "object",
      "properties": {
        "x": {
          "description": "X axis (0..=32767).",
          "type": "integer",
          "format": "uint16",
          "maximum": 32767,
          "minimum": 0
        },
        "y": {
          "description": "Y axis (0..=32767).",
          "type": "integer",
          "format": "uint16",
          "maximum": 32767,
          "minimum": 0
        }
      },
      "required": [
        "x",
        "y"
      ]
    },
    "QCode": {
      "description": "QEMU QKeyCode.",
      "type": "string",
      "pattern": "^[a-z0-9_]{1,32}$"
    }
  }
}
