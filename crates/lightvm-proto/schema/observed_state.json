{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ObservedState",
  "description": "Observed state of a VM, with source and instant.",
  "type": "object",
  "properties": {
    "observed_at": {
      "description": "Instant of the observation.",
      "$ref": "#/$defs/UtcTimestamp"
    },
    "run_id": {
      "description": "Run the observation refers to, if a process exists.",
      "anyOf": [
        {
          "$ref": "#/$defs/RunId"
        },
        {
          "type": "null"
        }
      ]
    },
    "source": {
      "description": "Source of the observation.",
      "$ref": "#/$defs/ObservationSource"
    },
    "state": {
      "description": "Observed state.",
      "$ref": "#/$defs/VmState"
    }
  },
  "required": [
    "state",
    "source",
    "observed_at"
  ],
  "$defs": {
    "ObservationSource": {
      "description": "Source of a state observation.",
      "oneOf": [
        {
          "description": "QEMU process handle (alive, terminated, exit code).",
          "type": "string",
          "const": "process"
        },
        {
          "description": "QMP reply or event (`query-status`, `SHUTDOWN`, ...).",
          "type": "string",
          "const": "qmp"
        },
        {
          "description": "Value persisted in the catalog: a hint, never sufficient on its own.",
          "type": "string",
          "const": "database"
        }
      ]
    },
    "RunId": {
      "description": "RunId: version 7 UUID, lowercase with hyphens.",
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "UtcTimestamp": {
      "description": "RFC 3339 UTC instant with Z suffix, millisecond precision.",
      "type": "string",
      "format": "date-time"
    },
    "VmState": {
      "description": "Lifecycle state of a VM.",
      "oneOf": [
        {
          "description": "Process absent and files released. The only state for operations on disks, NVRAM and media.",
          "type": "string",
          "const": "stopped"
        },
        {
          "description": "Spawn started, new `run_id` assigned, QMP not ready yet.",
          "type": "string",
          "const": "starting"
        },
        {
          "description": "Process alive and QMP ready.",
          "type": "string",
          "const": "running"
        },
        {
          "description": "Stop requested; complete only once the process end is observed.",
          "type": "string",
          "const": "stopping"
        },
        {
          "description": "Start error or unexpected exit. No automatic promotion to baseline.",
          "type": "string",
          "const": "failed"
        },
        {
          "description": "Reconciliation after a crash (journal, files, processes): no external mutation.",
          "type": "string",
          "const": "recovering"
        }
      ]
    }
  }
}
