{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClientMessage",
  "description": "Messages from the client to the service.",
  "oneOf": [
    {
      "description": "Mandatory first message.",
      "type": "object",
      "properties": {
        "client_name": {
          "description": "Client name, diagnostic only (truncated to 64 characters).",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "credential": {
          "description": "Channel credential: 32 bytes as 64 lowercase hexadecimal digits.\nIt stays free text in the schema so that a malformed credential\ngives the same outcome (`unauthenticated`) as a missing or wrong one,\nwithout distinguishing the reasons. Secret: never in logs or reports.",
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "writeOnly": true
        },
        "protocol_versions": {
          "description": "Protocol versions offered by the client.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        },
        "request_id": {
          "description": "Request identifier.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "type": {
          "type": "string",
          "const": "hello"
        }
      },
      "required": [
        "type",
        "request_id",
        "protocol_versions"
      ]
    },
    {
      "description": "Typed request after the handshake.",
      "type": "object",
      "properties": {
        "body": {
          "description": "Requested operation.",
          "$ref": "#/$defs/Request"
        },
        "request_id": {
          "description": "Request identifier.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "type": {
          "type": "string",
          "const": "request"
        }
      },
      "required": [
        "type",
        "request_id",
        "body"
      ]
    }
  ],
  "$defs": {
    "BaselineId": {
      "description": "BaselineId: version 7 UUID, lowercase with hyphens.",
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "DisplayGeometry": {
      "description": "Guest display geometry in pixels.",
      "type": "object",
      "properties": {
        "height": {
          "description": "Height (1..=8192).",
          "type": "integer",
          "format": "uint32",
          "maximum": 8192,
          "minimum": 1
        },
        "width": {
          "description": "Width (1..=8192).",
          "type": "integer",
          "format": "uint32",
          "maximum": 8192,
          "minimum": 1
        }
      },
      "required": [
        "width",
        "height"
      ]
    },
    "Firmware": {
      "description": "Guest firmware. In the MVP only UEFI with managed NVRAM state (ROADMAP 8).",
      "oneOf": [
        {
          "description": "UEFI (OVMF) with per-VM NVRAM.",
          "type": "string",
          "const": "uefi"
        }
      ]
    },
    "GuestOs": {
      "description": "Declared guest operating system. In the MVP the reference is Ubuntu LTS\nx86_64 with the version and checksum pinned in F0 (ROADMAP 4).",
      "oneOf": [
        {
          "description": "Ubuntu LTS x86_64 (MVP reference guest).",
          "type": "string",
          "const": "ubuntu_lts_x86_64"
        },
        {
          "description": "Other Linux x86_64: manageable manually, without compatibility guarantees.",
          "type": "string",
          "const": "other_linux_x86_64"
        }
      ]
    },
    "InputBatch": {
      "description": "Batch of input events tied to a run and a geometry: the core\nrejects batches tied to a superseded `run_id` or a non-current geometry\n(ROADMAP 6.4). Inputs are never repeated automatically.",
      "type": "object",
      "properties": {
        "events": {
          "description": "Events, at most [`MAX_INPUT_EVENTS_PER_REQUEST`].",
          "type": "array",
          "items": {
            "$ref": "#/$defs/InputEvent"
          }
        },
        "geometry": {
          "description": "Geometry on which the caller computed the coordinates.",
          "$ref": "#/$defs/DisplayGeometry"
        },
        "run_id": {
          "description": "Expected run.",
          "$ref": "#/$defs/RunId"
        },
        "vm_id": {
          "description": "Target VM.",
          "$ref": "#/$defs/VmId"
        }
      },
      "required": [
        "vm_id",
        "run_id",
        "geometry",
        "events"
      ]
    },
    "InputEvent": {
      "description": "Elementary input event.",
      "oneOf": [
        {
          "description": "Key.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "key"
            }
          },
          "$ref": "#/$defs/KeyAction",
          "required": [
            "type"
          ]
        },
        {
          "description": "Absolute movement.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "pointer_move"
            }
          },
          "$ref": "#/$defs/PointerMove",
          "required": [
            "type"
          ]
        },
        {
          "description": "Button.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "pointer_button"
            }
          },
          "$ref": "#/$defs/PointerButton",
          "required": [
            "type"
          ]
        }
      ]
    },
    "KeyAction": {
      "description": "Press or release of a key.",
      "type": "object",
      "properties": {
        "down": {
          "description": "`true` = pressed, `false` = released.",
          "type": "boolean"
        },
        "qcode": {
          "description": "QEMU key.",
          "$ref": "#/$defs/QCode"
        }
      },
      "required": [
        "qcode",
        "down"
      ]
    },
    "Label": {
      "description": "Text declared by the user, without control characters; never interpreted.",
      "type": "string",
      "maxLength": 256,
      "minLength": 1
    },
    "MediaId": {
      "description": "MediaId: version 7 UUID, lowercase with hyphens.",
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "MediaKind": {
      "description": "Kind of media in the media registry.",
      "oneOf": [
        {
          "description": "Guest installation ISO.",
          "type": "string",
          "const": "install_iso"
        },
        {
          "description": "Read-only data ISO to bring the software under test into the guest (ADR-0008).",
          "type": "string",
          "const": "data_iso"
        }
      ]
    },
    "MouseButton": {
      "description": "Pointer button (allowed QMP `InputButton` names).",
      "oneOf": [
        {
          "description": "Left.",
          "type": "string",
          "const": "left"
        },
        {
          "description": "Middle.",
          "type": "string",
          "const": "middle"
        },
        {
          "description": "Right.",
          "type": "string",
          "const": "right"
        },
        {
          "description": "Wheel up.",
          "type": "string",
          "const": "wheel_up"
        },
        {
          "description": "Wheel down.",
          "type": "string",
          "const": "wheel_down"
        }
      ]
    },
    "NetworkProfile": {
      "description": "Network profile. In the MVP the only allowed value is `offline` (ADR-0004): no\nguest NIC, default network devices excluded, no forwarding.",
      "oneOf": [
        {
          "description": "No NIC.",
          "type": "string",
          "const": "offline"
        }
      ]
    },
    "OperationId": {
      "description": "OperationId: version 7 UUID, lowercase with hyphens.",
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "ParentLossPolicy": {
      "description": "Fate of the VMs when the UI that started the service ends without a\ncontrolled shutdown (crash, forced termination). ADR-0015 part B.",
      "oneOf": [
        {
          "description": "Emergency Stop of all VMs, then shutdown of the service (default).",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "kill_vms"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "description": "Orderly (ACPI) shutdown with a bounded wait, then `quit` and\ntermination; finally shutdown of the service.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "shutdown_vms"
            },
            "powerdown_s": {
              "description": "Wait for the ACPI shutdown per VM, in seconds\n([`MIN_PARENT_LOSS_POWERDOWN_S`]..=[`MAX_PARENT_LOSS_POWERDOWN_S`]).",
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "powerdown_s"
          ]
        },
        {
          "description": "The VMs stay on and the service stays active without a UI.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "keep_vms"
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "PointerButton": {
      "description": "Press or release of a pointer button.",
      "type": "object",
      "properties": {
        "button": {
          "description": "Button.",
          "$ref": "#/$defs/MouseButton"
        },
        "down": {
          "description": "`true` = pressed, `false` = released.",
          "type": "boolean"
        }
      },
      "required": [
        "button",
        "down"
      ]
    },
    "PointerMove": {
      "description": "Absolute pointer movement in QEMU coordinates 0..=32767 on each axis.",
      "type": "object",
      "properties": {
        "x": {
          "description": "X axis (0..=32767).",
          "type": "integer",
          "format": "uint16",
          "maximum": 32767,
          "minimum": 0
        },
        "y": {
          "description": "Y axis (0..=32767).",
          "type": "integer",
          "format": "uint16",
          "maximum": 32767,
          "minimum": 0
        }
      },
      "required": [
        "x",
        "y"
      ]
    },
    "QCode": {
      "description": "QEMU QKeyCode.",
      "type": "string",
      "pattern": "^[a-z0-9_]{1,32}$"
    },
    "Request": {
      "description": "Typed operations.",
      "oneOf": [
        {
          "description": "Liveness check.",
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "ping"
            }
          },
          "required": [
            "op"
          ]
        },
        {
          "description": "Capabilities of the service and the backend.",
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "get_capabilities"
            }
          },
          "required": [
            "op"
          ]
        },
        {
          "description": "List of the catalog VMs (UI only).",
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "list_vms"
            }
          },
          "required": [
            "op"
          ]
        },
        {
          "description": "Status of a VM (UI only).",
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "vm_status"
            },
            "vm_id": {
              "description": "VM.",
              "$ref": "#/$defs/VmId"
            }
          },
          "required": [
            "op",
            "vm_id"
          ]
        },
        {
          "description": "Creation of a VM in the catalog (UI only; never from agent sessions).",
          "type": "object",
          "properties": {
            "config": {
              "description": "Requested configuration.",
              "$ref": "#/$defs/VmConfig"
            },
            "op": {
              "type": "string",
              "const": "create_vm"
            }
          },
          "required": [
            "op",
            "config"
          ]
        },
        {
          "description": "Change to the configuration of a stopped VM: resources and limits\n(UI only; the disk can only grow).",
          "type": "object",
          "properties": {
            "config": {
              "description": "New full configuration.",
              "$ref": "#/$defs/VmConfig"
            },
            "expected_revision": {
              "description": "Expected revision: a concurrent change is rejected.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "op": {
              "type": "string",
              "const": "update_vm"
            },
            "vm_id": {
              "description": "VM.",
              "$ref": "#/$defs/VmId"
            }
          },
          "required": [
            "op",
            "vm_id",
            "expected_revision",
            "config"
          ]
        },
        {
          "description": "Action on an existing VM through the core's queue (UI only in F1).\nThe response arrives after the backend outcome, except for `stop`\nwith a backend that stops in the background (QEMU): the response\narrives when the graceful stop has started (operation `forwarded`, VM\n`stopping`) and the end is published as a `vm_state` event.",
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "submit_vm"
            },
            "request": {
              "description": "Request with idempotency key.",
              "$ref": "#/$defs/VmRequest"
            }
          },
          "required": [
            "op",
            "request"
          ]
        },
        {
          "description": "Subscription to state events (UI only).",
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "subscribe"
            }
          },
          "required": [
            "op"
          ]
        },
        {
          "description": "List of active connections (UI only).",
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "list_connections"
            }
          },
          "required": [
            "op"
          ]
        },
        {
          "description": "Revocation of a connection and its credential (UI only).",
          "type": "object",
          "properties": {
            "connection_id": {
              "description": "Connection to revoke.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "op": {
              "type": "string",
              "const": "revoke_connection"
            }
          },
          "required": [
            "op",
            "connection_id"
          ]
        },
        {
          "description": "Issuing of a pairing credential to be delivered out of band (UI only).",
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "create_pairing_credential"
            }
          },
          "required": [
            "op"
          ]
        },
        {
          "description": "Emergency Stop: priority path, does not go through the queue (UI only).",
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "emergency_stop"
            }
          },
          "required": [
            "op"
          ]
        },
        {
          "description": "Fate of the VMs if the UI ends without a controlled shutdown (UI only).\nTakes effect immediately; the UI sends it again at every service start.",
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "set_parent_loss_policy"
            },
            "policy": {
              "description": "New policy.",
              "$ref": "#/$defs/ParentLossPolicy"
            }
          },
          "required": [
            "op",
            "policy"
          ]
        },
        {
          "description": "Controlled shutdown of the service (UI only).",
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "shutdown"
            }
          },
          "required": [
            "op"
          ]
        },
        {
          "description": "Approved media of the registry (UI only).",
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "list_media"
            }
          },
          "required": [
            "op"
          ]
        },
        {
          "description": "Import of an ISO chosen by the user with the native picker of the UI\n(UI only, never from agent sessions): read-only managed copy, SHA-256\nand registry row (ADR-0008). The path is opened as a regular file\nwithout following links and is never passed to QEMU.",
          "type": "object",
          "properties": {
            "declared_origin": {
              "description": "Origin declared by the user (free text, never interpreted).",
              "type": "string"
            },
            "media_kind": {
              "description": "Kind of media.",
              "$ref": "#/$defs/MediaKind"
            },
            "op": {
              "type": "string",
              "const": "import_media"
            },
            "source_path": {
              "description": "File chosen by the user.",
              "type": "string"
            }
          },
          "required": [
            "op",
            "source_path",
            "media_kind",
            "declared_origin"
          ]
        },
        {
          "description": "Deletion of a stopped VM with its disk and run files (UI only).",
          "type": "object",
          "properties": {
            "expected_revision": {
              "description": "Expected revision: a concurrent change is rejected.",
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "op": {
              "type": "string",
              "const": "delete_vm"
            },
            "vm_id": {
              "description": "VM.",
              "$ref": "#/$defs/VmId"
            }
          },
          "required": [
            "op",
            "vm_id",
            "expected_revision"
          ]
        },
        {
          "description": "Console of a running VM (UI only): per-run display ticket (ADR-0013).\nThe ticket is revoked when the run ends, on Emergency Stop and when\nthe connection is revoked.",
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "open_console"
            },
            "vm_id": {
              "description": "VM.",
              "$ref": "#/$defs/VmId"
            }
          },
          "required": [
            "op",
            "vm_id"
          ]
        },
        {
          "description": "Baselines of a VM (UI only, F3).",
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "list_baselines"
            },
            "vm_id": {
              "description": "VM.",
              "$ref": "#/$defs/VmId"
            }
          },
          "required": [
            "op",
            "vm_id"
          ]
        },
        {
          "description": "Creation of a baseline with the VM off (UI only, F3; ROADMAP 8,\nADR-0005): the VM's current disk and UEFI variables are materialized\ninto a standalone, read-only, hashed baseline. Long operation (a\n`qemu-img convert` of the whole disk): it runs outside the supervisor\nthread, the VM is busy meanwhile (`vm_busy` for other mutations,\n[`VmBaselines::operation`] set) and the reply arrives when it ends.\nCancelled by the Emergency Stop, by the revocation or closing of the\nconnection and by the service shutdown (nothing is published).",
          "type": "object",
          "properties": {
            "allow_unclean": {
              "description": "The last run did not end with an observed clean guest shutdown\n(forced stop, Emergency Stop, crash, supervisor restart since):\nwithout this flag the creation is refused (`state_conflict`,\ndetail `reason` = `unclean_shutdown`); with it the baseline is\nrecorded as **not verified** (`clean_shutdown: false`) and is\nnever promoted to verified later.",
              "type": "boolean",
              "default": false
            },
            "label": {
              "description": "Label shown to the user.",
              "$ref": "#/$defs/Label"
            },
            "op": {
              "type": "string",
              "const": "create_baseline"
            },
            "vm_id": {
              "description": "VM (must be `stopped`).",
              "$ref": "#/$defs/VmId"
            }
          },
          "required": [
            "op",
            "vm_id",
            "label"
          ]
        },
        {
          "description": "Restore of a baseline with the VM off (UI only, F3): the VM's current\nstate (standalone disk or previous overlay, and UEFI variables) is\n**discarded** and replaced by a new QCOW2 overlay backed by the\nbaseline plus a fresh copy of the baseline's UEFI variables. The\nbaseline's hash is verified first. The guest restarts with a normal\nboot at the next start. The reply arrives when done, as for\n`create_baseline` (same cancellation rules).",
          "type": "object",
          "properties": {
            "baseline_id": {
              "description": "Baseline of the same VM.",
              "$ref": "#/$defs/BaselineId"
            },
            "op": {
              "type": "string",
              "const": "restore_baseline"
            },
            "vm_id": {
              "description": "VM (must be `stopped`).",
              "$ref": "#/$defs/VmId"
            }
          },
          "required": [
            "op",
            "vm_id",
            "baseline_id"
          ]
        },
        {
          "description": "Deletion of a baseline (UI only, F3; the UI asks for confirmation).\nRefused if the baseline is in use (the VM's current state is an\noverlay of it) or protected.",
          "type": "object",
          "properties": {
            "baseline_id": {
              "description": "Baseline of the same VM.",
              "$ref": "#/$defs/BaselineId"
            },
            "op": {
              "type": "string",
              "const": "delete_baseline"
            },
            "vm_id": {
              "description": "VM (must be `stopped`).",
              "$ref": "#/$defs/VmId"
            }
          },
          "required": [
            "op",
            "vm_id",
            "baseline_id"
          ]
        }
      ]
    },
    "RunId": {
      "description": "RunId: version 7 UUID, lowercase with hyphens.",
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "VmAction": {
      "description": "Action requested on an existing VM.",
      "oneOf": [
        {
          "description": "Start.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "start"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "Ordinary stop.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "stop"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "Forced stop with OS primitives.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "force_stop"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "Guest reset.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "reset"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "Screenshot.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "screenshot"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "Typed input.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "input"
            }
          },
          "$ref": "#/$defs/InputBatch",
          "required": [
            "type"
          ]
        }
      ]
    },
    "VmConfig": {
      "description": "VM configuration requested by the user. No field is a path or\na QEMU option: media are referenced by [`MediaId`] of the approved registry.",
      "type": "object",
      "properties": {
        "data_media": {
          "description": "Optional read-only data media (kind `data_iso`), attached with the VM off.",
          "anyOf": [
            {
              "$ref": "#/$defs/MediaId"
            },
            {
              "type": "null"
            }
          ]
        },
        "disk_gib": {
          "description": "Virtual size of the main QCOW2 disk in GiB.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "firmware": {
          "description": "Firmware; in the MVP only `uefi`.",
          "$ref": "#/$defs/Firmware",
          "default": "uefi"
        },
        "guest_os": {
          "description": "Declared guest operating system.",
          "$ref": "#/$defs/GuestOs"
        },
        "install_media": {
          "description": "Installation media from the media registry (kind `install_iso`).",
          "anyOf": [
            {
              "$ref": "#/$defs/MediaId"
            },
            {
              "type": "null"
            }
          ]
        },
        "limits": {
          "description": "Execution limits applied by the supervisor to the QEMU process\n(ADR-0017); missing in older catalogs → default values.",
          "$ref": "#/$defs/VmLimits",
          "default": {
            "cpu_max_percent": 100,
            "memory_margin_mib": 1024
          }
        },
        "memory_mib": {
          "description": "Guest memory in MiB (not the limit of the whole QEMU process).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "name": {
          "description": "Visible name.",
          "$ref": "#/$defs/VmName"
        },
        "network": {
          "description": "Network profile; in the MVP only `offline`.",
          "$ref": "#/$defs/NetworkProfile",
          "default": "offline"
        },
        "vcpus": {
          "description": "Number of vCPUs (not a CPU percentage limit: ROADMAP 7.2).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "guest_os",
        "vcpus",
        "memory_mib",
        "disk_gib"
      ]
    },
    "VmId": {
      "description": "VmId: version 7 UUID, lowercase with hyphens.",
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "VmLimits": {
      "description": "Execution limits of a VM (ADR-0017), set by the user in the\nVM settings and applied by the supervisor, never by the client.",
      "type": "object",
      "properties": {
        "cpu_max_percent": {
          "description": "CPU cap as a percentage of the capacity of the assigned vCPUs\n([`MIN_CPU_MAX_PERCENT`]..=100; 100 = no cap). Applied by the\noperating system to the whole QEMU process.",
          "type": "integer",
          "format": "uint8",
          "default": 100,
          "maximum": 255,
          "minimum": 0
        },
        "memory_margin_mib": {
          "description": "Memory granted to the QEMU process beyond the guest RAM, in MiB\n([`MIN_MEMORY_MARGIN_MIB`]..=[`MAX_MEMORY_MARGIN_MIB`]). When the\nlimit is exceeded, QEMU is terminated and the exit is classified as a resource limit.",
          "type": "integer",
          "format": "uint32",
          "default": 1024,
          "minimum": 0
        },
        "storage_budget_gib": {
          "description": "Maximum space in GiB for the VM's files beyond the main disk\n(overlays, baselines, firmware variables); `None` = no dedicated budget.\nChecked at every start.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "VmName": {
      "description": "VM name: ASCII label, not a path.",
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9 ._-]*$"
    },
    "VmRequest": {
      "description": "Request for an action on a VM.",
      "type": "object",
      "properties": {
        "action": {
          "description": "Action (object with a `type` discriminant).",
          "$ref": "#/$defs/VmAction"
        },
        "expected_run_id": {
          "description": "Expected run: mandatory for reset, screenshot and input; if present\nand different from the current run the request is rejected (`state_conflict`).",
          "anyOf": [
            {
              "$ref": "#/$defs/RunId"
            },
            {
              "type": "null"
            }
          ]
        },
        "operation_id": {
          "description": "Idempotency key chosen by the caller: the same request repeated with\nthe same `operation_id` does not duplicate the effect.",
          "$ref": "#/$defs/OperationId"
        },
        "vm_id": {
          "description": "VM.",
          "$ref": "#/$defs/VmId"
        }
      },
      "required": [
        "operation_id",
        "vm_id",
        "action"
      ]
    }
  }
}
