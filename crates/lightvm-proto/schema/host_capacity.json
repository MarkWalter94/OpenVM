{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HostCapacity",
  "description": "Capacità dell'host rilevate dal probe (fornite al core, mai inventate).",
  "type": "object",
  "properties": {
    "accelerator_available": {
      "description": "Acceleratore hardware disponibile e approvato (nessun fallback TCG: ADR-0007).",
      "type": "boolean"
    },
    "baseline_available": {
      "description": "Baseline e ripristino disponibili (da F3).",
      "type": "boolean"
    },
    "free_storage_gib": {
      "description": "Spazio libero sul volume del catalogo in GiB.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "input_available": {
      "description": "Input tipizzato disponibile nel backend.",
      "type": "boolean"
    },
    "logical_cpus": {
      "description": "Processori logici.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "reserved_memory_mib": {
      "description": "Memoria da lasciare all'host in MiB (riserva).",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "reserved_storage_gib": {
      "description": "Spazio da lasciare libero in GiB (riserva, ADR-0017).",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "screenshot_available": {
      "description": "Cattura dello schermo disponibile nel backend.",
      "type": "boolean"
    },
    "total_memory_mib": {
      "description": "Memoria fisica totale in MiB.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    }
  },
  "required": [
    "logical_cpus",
    "total_memory_mib",
    "reserved_memory_mib",
    "free_storage_gib",
    "reserved_storage_gib",
    "accelerator_available",
    "screenshot_available",
    "input_available",
    "baseline_available"
  ]
}
