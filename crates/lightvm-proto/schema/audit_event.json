{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AuditEvent",
  "description": "Audit event. `seq` is the total order assigned by the core, strictly increasing.",
  "type": "object",
  "properties": {
    "action": {
      "description": "Action.",
      "$ref": "#/$defs/AuditAction"
    },
    "actor": {
      "description": "Actor.",
      "$ref": "#/$defs/Actor"
    },
    "at": {
      "description": "UTC instant.",
      "$ref": "#/$defs/UtcTimestamp"
    },
    "capability": {
      "description": "Capability evaluated (for denials).",
      "anyOf": [
        {
          "$ref": "#/$defs/Capability"
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "description": "Public error code (for denials and failures).",
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorCode"
        },
        {
          "type": "null"
        }
      ]
    },
    "operation_id": {
      "description": "Operation involved.",
      "anyOf": [
        {
          "$ref": "#/$defs/OperationId"
        },
        {
          "type": "null"
        }
      ]
    },
    "outcome": {
      "description": "Outcome.",
      "$ref": "#/$defs/AuditOutcome"
    },
    "run_id": {
      "description": "Run involved.",
      "anyOf": [
        {
          "$ref": "#/$defs/RunId"
        },
        {
          "type": "null"
        }
      ]
    },
    "seq": {
      "description": "Order (from 1, strictly increasing).",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "session_id": {
      "description": "Session involved.",
      "anyOf": [
        {
          "$ref": "#/$defs/SessionId"
        },
        {
          "type": "null"
        }
      ]
    },
    "termination": {
      "description": "Termination cause (for `session_terminate`).",
      "anyOf": [
        {
          "$ref": "#/$defs/TerminationCause"
        },
        {
          "type": "null"
        }
      ]
    },
    "vm_id": {
      "description": "VM involved.",
      "anyOf": [
        {
          "$ref": "#/$defs/VmId"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "seq",
    "at",
    "actor",
    "action",
    "outcome"
  ],
  "$defs": {
    "Actor": {
      "description": "Actor recorded in the audit (without secrets).",
      "oneOf": [
        {
          "description": "Local user.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "user"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "description": "Agent session.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "agent"
            },
            "session_id": {
              "description": "Session.",
              "$ref": "#/$defs/SessionId"
            }
          },
          "required": [
            "kind",
            "session_id"
          ]
        },
        {
          "description": "Supervisor (expiries, reconciliation, observations).",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "system"
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "AuditAction": {
      "description": "Type of recorded action.",
      "oneOf": [
        {
          "description": "VM creation.",
          "type": "string",
          "const": "vm_create"
        },
        {
          "description": "VM start (request forwarded or outcome).",
          "type": "string",
          "const": "vm_start"
        },
        {
          "description": "VM stop (ordinary or forced).",
          "type": "string",
          "const": "vm_stop"
        },
        {
          "description": "VM reset.",
          "type": "string",
          "const": "vm_reset"
        },
        {
          "description": "Screenshot.",
          "type": "string",
          "const": "vm_screenshot"
        },
        {
          "description": "Input (implicit count only, never the content).",
          "type": "string",
          "const": "vm_input"
        },
        {
          "description": "Observed state change (process/QMP).",
          "type": "string",
          "const": "vm_state_observed"
        },
        {
          "description": "Emergency Stop.",
          "type": "string",
          "const": "emergency_stop"
        },
        {
          "description": "Session creation.",
          "type": "string",
          "const": "session_create"
        },
        {
          "description": "Session pause.",
          "type": "string",
          "const": "session_pause"
        },
        {
          "description": "Session resume.",
          "type": "string",
          "const": "session_resume"
        },
        {
          "description": "Session termination (revocation, expiry...).",
          "type": "string",
          "const": "session_terminate"
        },
        {
          "description": "Operation discarded before forwarding.",
          "type": "string",
          "const": "operation_discard"
        },
        {
          "description": "Change to a VM's configuration (resources and limits).",
          "type": "string",
          "const": "vm_configure"
        },
        {
          "description": "Deletion of a stopped VM with its files.",
          "type": "string",
          "const": "vm_delete"
        },
        {
          "description": "Import of a medium into the approved registry (user only).",
          "type": "string",
          "const": "media_import"
        },
        {
          "description": "Issue of a per-run console display ticket (never the token).",
          "type": "string",
          "const": "console_open"
        },
        {
          "description": "Revocation of a console display ticket (run ended, UI connection\nclosed or revoked, Emergency Stop, new ticket, shutdown); the cause is\nin `termination`.",
          "type": "string",
          "const": "console_revoke"
        },
        {
          "description": "Creation of a baseline with the VM off (F3).",
          "type": "string",
          "const": "baseline_create"
        },
        {
          "description": "Restore of a baseline: the previous current state (disk or overlay\nand UEFI variables) is discarded (F3).",
          "type": "string",
          "const": "baseline_restore"
        },
        {
          "description": "Deletion of a baseline (F3).",
          "type": "string",
          "const": "baseline_delete"
        },
        {
          "description": "Session request of an agent (F4): received, or refused (agent access\noff, limits). Never the declared texts.",
          "type": "string",
          "const": "session_request"
        },
        {
          "description": "Session request denied by the user, expired or withdrawn (F4).",
          "type": "string",
          "const": "session_deny"
        },
        {
          "description": "Lease renewal of an agent session (F4).",
          "type": "string",
          "const": "session_lease"
        },
        {
          "description": "Change of the input owner of a VM (F4).",
          "type": "string",
          "const": "input_control"
        },
        {
          "description": "Agent access switch turned on (F4).",
          "type": "string",
          "const": "agent_access_enable"
        },
        {
          "description": "Agent access switch turned off (F4): pending requests denied, live\nsessions revoked.",
          "type": "string",
          "const": "agent_access_disable"
        },
        {
          "description": "VM list read by an agent session (F4).",
          "type": "string",
          "const": "vm_list"
        },
        {
          "description": "VM status read by an agent session (F4).",
          "type": "string",
          "const": "vm_status"
        },
        {
          "description": "Screenshot bytes read by an agent session (F4, never the bytes).",
          "type": "string",
          "const": "screenshot_read"
        }
      ]
    },
    "AuditOutcome": {
      "description": "Recorded outcome.",
      "oneOf": [
        {
          "description": "Accepted (queued).",
          "type": "string",
          "const": "accepted"
        },
        {
          "description": "Forwarded to the backend.",
          "type": "string",
          "const": "forwarded"
        },
        {
          "description": "Completed.",
          "type": "string",
          "const": "succeeded"
        },
        {
          "description": "Failed.",
          "type": "string",
          "const": "failed"
        },
        {
          "description": "Denied: no effect.",
          "type": "string",
          "const": "denied"
        },
        {
          "description": "Discarded before forwarding: no effect.",
          "type": "string",
          "const": "discarded"
        }
      ]
    },
    "Capability": {
      "description": "Authorizable action on a VM. Serialized names follow the MCP catalog\n(ROADMAP 9); `vm.input` covers mouse and keyboard.",
      "oneOf": [
        {
          "description": "List filtered by the grant.",
          "type": "string",
          "const": "vm.list"
        },
        {
          "description": "Status.",
          "type": "string",
          "const": "vm.status"
        },
        {
          "description": "Start.",
          "type": "string",
          "const": "vm.start"
        },
        {
          "description": "Stop (ordinary or forced).",
          "type": "string",
          "const": "vm.stop"
        },
        {
          "description": "Reset: requires an explicit capability.",
          "type": "string",
          "const": "vm.reset"
        },
        {
          "description": "Screenshot.",
          "type": "string",
          "const": "vm.screenshot"
        },
        {
          "description": "Mouse and keyboard.",
          "type": "string",
          "const": "vm.input"
        },
        {
          "description": "Checkpoint with the VM off: requires an explicit capability.",
          "type": "string",
          "const": "vm.snapshot"
        },
        {
          "description": "Restore with the VM off.",
          "type": "string",
          "const": "vm.restore"
        },
        {
          "description": "Authorized LightVM events and QEMU logs.",
          "type": "string",
          "const": "vm.logs"
        }
      ]
    },
    "ErrorCode": {
      "description": "Stable code of an operational error. Serialized names never change;\nnew codes are only ever added.",
      "oneOf": [
        {
          "description": "Caller identified (valid credential) but not authorized for the action:\nVM outside the allowlist, missing capability, paused session, insufficient\nrole. Missing or invalid credentials: [`ErrorCode::Unauthenticated`].",
          "type": "string",
          "const": "permission_denied"
        },
        {
          "description": "Session or lease expired: a new authorization in the app is needed.",
          "type": "string",
          "const": "session_expired"
        },
        {
          "description": "Another mutation is in progress or queued on the same VM: retryable.",
          "type": "string",
          "const": "vm_busy"
        },
        {
          "description": "Capability not available on this host, build or phase.",
          "type": "string",
          "const": "unsupported"
        },
        {
          "description": "The action is not allowed in the current state (or refers to a superseded `run_id`).",
          "type": "string",
          "const": "state_conflict"
        },
        {
          "description": "Resource, quota or size limit exceeded.",
          "type": "string",
          "const": "resource_limit"
        },
        {
          "description": "Invalid argument (format, range, name, rejected path).",
          "type": "string",
          "const": "invalid_argument"
        },
        {
          "description": "Object does not exist or is not visible to the caller.",
          "type": "string",
          "const": "not_found"
        },
        {
          "description": "Infrastructure failure (QEMU, QMP, storage, OS) not attributable to the caller.",
          "type": "string",
          "const": "infrastructure_error"
        },
        {
          "description": "No valid credential: IPC credential or session token missing,\nmalformed, unknown, revoked or reused after a supervisor restart.\nA new authorization in the app is needed. Appended after the first nine\ncodes, which remain unchanged.",
          "type": "string",
          "const": "unauthenticated"
        }
      ]
    },
    "OperationId": {
      "description": "OperationId: version 7 UUID, lowercase with hyphens.",
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "RunId": {
      "description": "RunId: version 7 UUID, lowercase with hyphens.",
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "SessionId": {
      "description": "SessionId: version 7 UUID, lowercase with hyphens.",
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "TerminationCause": {
      "description": "Termination cause of a session (recorded in the report, ROADMAP 9).",
      "oneOf": [
        {
          "description": "Ordinary close from the app.",
          "type": "string",
          "const": "completed"
        },
        {
          "description": "Revoked by the user.",
          "type": "string",
          "const": "revoked"
        },
        {
          "description": "Emergency Stop.",
          "type": "string",
          "const": "emergency_stop"
        },
        {
          "description": "Grant expired.",
          "type": "string",
          "const": "grant_expired"
        },
        {
          "description": "Lease not renewed within the limit.",
          "type": "string",
          "const": "lease_expired"
        },
        {
          "description": "Loss of the client or of the adapter.",
          "type": "string",
          "const": "client_lost"
        },
        {
          "description": "UI closed or crashed.",
          "type": "string",
          "const": "ui_closed"
        },
        {
          "description": "Supervisor lost or restarted.",
          "type": "string",
          "const": "supervisor_lost"
        },
        {
          "description": "Host resumed from sleep.",
          "type": "string",
          "const": "host_resumed"
        },
        {
          "description": "VM failed or terminated during the session.",
          "type": "string",
          "const": "vm_terminated"
        },
        {
          "description": "Baseline restore: the control session closes (ROADMAP 8).",
          "type": "string",
          "const": "restored"
        }
      ]
    },
    "UtcTimestamp": {
      "description": "RFC 3339 UTC instant with Z suffix, millisecond precision.",
      "type": "string",
      "format": "date-time"
    },
    "VmId": {
      "description": "VmId: version 7 UUID, lowercase with hyphens.",
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
