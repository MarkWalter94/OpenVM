{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DisplayGeometry",
  "description": "Geometria del display guest in pixel.",
  "type": "object",
  "properties": {
    "height": {
      "description": "Altezza (1..=8192).",
      "type": "integer",
      "format": "uint32",
      "maximum": 8192,
      "minimum": 1
    },
    "width": {
      "description": "Larghezza (1..=8192).",
      "type": "integer",
      "format": "uint32",
      "maximum": 8192,
      "minimum": 1
    }
  },
  "required": [
    "width",
    "height"
  ]
}
