{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BaselineRecord",
  "description": "Baseline a VM spenta: disco autonomo più stato firmware, immutabile.",
  "type": "object",
  "properties": {
    "config_revision": {
      "description": "Revisione della configurazione VM registrata con la baseline.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "created_at": {
      "description": "Istante di creazione.",
      "$ref": "#/$defs/UtcTimestamp"
    },
    "disk_sha256": {
      "description": "SHA-256 dell'immagine disco della baseline.",
      "$ref": "#/$defs/Sha256Digest"
    },
    "firmware_sha256": {
      "description": "SHA-256 dello stato firmware (NVRAM) della baseline.",
      "$ref": "#/$defs/Sha256Digest"
    },
    "id": {
      "description": "Identificativo.",
      "$ref": "#/$defs/BaselineId"
    },
    "label": {
      "description": "Etichetta opzionale.",
      "anyOf": [
        {
          "$ref": "#/$defs/Label"
        },
        {
          "type": "null"
        }
      ]
    },
    "origin": {
      "description": "Origine.",
      "$ref": "#/$defs/BaselineOrigin"
    },
    "protected": {
      "description": "Baseline iniziale protetta: non cancellabile né sostituibile dai tool agente.",
      "type": "boolean"
    },
    "vm_id": {
      "description": "VM di appartenenza.",
      "$ref": "#/$defs/VmId"
    }
  },
  "required": [
    "id",
    "vm_id",
    "config_revision",
    "origin",
    "disk_sha256",
    "firmware_sha256",
    "protected",
    "created_at"
  ],
  "$defs": {
    "BaselineId": {
      "description": "BaselineId: UUID versione 7 in minuscolo con trattini.",
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "BaselineOrigin": {
      "description": "Origine di una baseline (ROADMAP 8).",
      "oneOf": [
        {
          "description": "Registrata dopo arresto corretto osservato.",
          "type": "string",
          "const": "clean_shutdown"
        },
        {
          "description": "Checkpoint materializzato da un overlay a VM spenta.",
          "type": "string",
          "const": "checkpoint"
        }
      ]
    },
    "Label": {
      "description": "Testo dichiarato dall'utente, senza caratteri di controllo; mai interpretato.",
      "type": "string",
      "maxLength": 256,
      "minLength": 1
    },
    "Sha256Digest": {
      "description": "SHA-256 in esadecimale minuscolo.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "UtcTimestamp": {
      "description": "Istante UTC RFC 3339 con suffisso Z, precisione al millisecondo.",
      "type": "string",
      "format": "date-time"
    },
    "VmId": {
      "description": "VmId: UUID versione 7 in minuscolo con trattini.",
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
