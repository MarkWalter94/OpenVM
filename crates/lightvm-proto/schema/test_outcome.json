{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TestOutcome",
  "description": "Outcome of a test (ROADMAP 9). Completing the conversation does not\nautomatically produce `passed`.",
  "oneOf": [
    {
      "description": "Criteria verified.",
      "type": "string",
      "const": "passed"
    },
    {
      "description": "Criteria not met.",
      "type": "string",
      "const": "failed"
    },
    {
      "description": "No reliable verifier or insufficient evidence.",
      "type": "string",
      "const": "inconclusive"
    },
    {
      "description": "Cancelled by the user.",
      "type": "string",
      "const": "cancelled"
    },
    {
      "description": "Time ran out.",
      "type": "string",
      "const": "timed_out"
    },
    {
      "description": "Infrastructure failure, distinct from a model failure.",
      "type": "string",
      "const": "infrastructure_error"
    }
  ]
}
