{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SessionState",
  "description": "State of an agent session.",
  "oneOf": [
    {
      "description": "Active.",
      "type": "string",
      "const": "active"
    },
    {
      "description": "Agent pause: no new mutation forwarded; observation allowed.",
      "type": "string",
      "const": "paused"
    },
    {
      "description": "Terminated (revocation, expiry, Emergency Stop, client loss...). Final.",
      "type": "string",
      "const": "terminated"
    }
  ]
}
