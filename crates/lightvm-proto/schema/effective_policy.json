{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EffectivePolicy",
  "description": "Effective policy resulting from the intersection, with the applied revision.",
  "type": "object",
  "properties": {
    "capabilities": {
      "description": "Effective capabilities.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Capability"
      },
      "uniqueItems": true
    },
    "quotas": {
      "description": "Effective quotas.",
      "$ref": "#/$defs/Quotas"
    },
    "revision": {
      "description": "Revision of the applied policy.",
      "$ref": "#/$defs/PolicyRevision"
    }
  },
  "required": [
    "capabilities",
    "quotas",
    "revision"
  ],
  "$defs": {
    "Capability": {
      "description": "Authorizable action on a VM. Serialized names follow the MCP catalog\n(ROADMAP 9); `vm.input` covers mouse and keyboard.",
      "oneOf": [
        {
          "description": "List filtered by the grant.",
          "type": "string",
          "const": "vm.list"
        },
        {
          "description": "Status.",
          "type": "string",
          "const": "vm.status"
        },
        {
          "description": "Start.",
          "type": "string",
          "const": "vm.start"
        },
        {
          "description": "Stop (ordinary or forced).",
          "type": "string",
          "const": "vm.stop"
        },
        {
          "description": "Reset: requires an explicit capability.",
          "type": "string",
          "const": "vm.reset"
        },
        {
          "description": "Screenshot.",
          "type": "string",
          "const": "vm.screenshot"
        },
        {
          "description": "Mouse and keyboard.",
          "type": "string",
          "const": "vm.input"
        },
        {
          "description": "Checkpoint with the VM off: requires an explicit capability.",
          "type": "string",
          "const": "vm.snapshot"
        },
        {
          "description": "Restore with the VM off.",
          "type": "string",
          "const": "vm.restore"
        },
        {
          "description": "Authorized LightVM events and QEMU logs.",
          "type": "string",
          "const": "vm.logs"
        }
      ]
    },
    "PolicyRevision": {
      "description": "Monotonic revision of the applied policy (recorded in reports, ROADMAP 9).",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "Quotas": {
      "description": "Quotas of a session or of a policy layer. Each field is an inclusive\nmaximum; the intersection takes the minimum.",
      "type": "object",
      "properties": {
        "max_input_events": {
          "description": "Total input events allowed in the session.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "max_operations": {
          "description": "Total operations allowed in the session.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "max_queued_operations": {
          "description": "Operations queued per VM and not yet forwarded.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "max_screenshot_bytes": {
          "description": "Maximum size of a single screenshot in bytes.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "max_screenshots": {
          "description": "Total screenshots allowed in the session.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "max_operations",
        "max_input_events",
        "max_screenshots",
        "max_screenshot_bytes",
        "max_queued_operations"
      ]
    }
  }
}
