{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RunRecord",
  "description": "Run: one QEMU process from start to observed end.",
  "type": "object",
  "properties": {
    "baseline_id": {
      "description": "Starting baseline (from F3).",
      "anyOf": [
        {
          "$ref": "#/$defs/BaselineId"
        },
        {
          "type": "null"
        }
      ]
    },
    "config_revision": {
      "description": "Configuration revision used for the start.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "end_reason": {
      "description": "Reason for the end.",
      "anyOf": [
        {
          "$ref": "#/$defs/RunEndReason"
        },
        {
          "type": "null"
        }
      ]
    },
    "ended_at": {
      "description": "Instant of the observed end.",
      "anyOf": [
        {
          "$ref": "#/$defs/UtcTimestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "description": "Identifier.",
      "$ref": "#/$defs/RunId"
    },
    "started_at": {
      "description": "Start instant.",
      "$ref": "#/$defs/UtcTimestamp"
    },
    "vm_id": {
      "description": "VM.",
      "$ref": "#/$defs/VmId"
    }
  },
  "required": [
    "id",
    "vm_id",
    "config_revision",
    "started_at"
  ],
  "$defs": {
    "BaselineId": {
      "description": "BaselineId: version 7 UUID, lowercase with hyphens.",
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "RunEndReason": {
      "description": "Reason a run ended.",
      "oneOf": [
        {
          "description": "Ordinary stop completed (process end observed).",
          "type": "string",
          "const": "stopped"
        },
        {
          "description": "Forced stop requested (unclean state).",
          "type": "string",
          "const": "force_stopped"
        },
        {
          "description": "Emergency Stop.",
          "type": "string",
          "const": "emergency_stop"
        },
        {
          "description": "Start failed.",
          "type": "string",
          "const": "start_failed"
        },
        {
          "description": "Unexpected process exit.",
          "type": "string",
          "const": "unexpected_exit"
        },
        {
          "description": "Run closed by reconciliation after a supervisor crash.",
          "type": "string",
          "const": "reconciled"
        }
      ]
    },
    "RunId": {
      "description": "RunId: version 7 UUID, lowercase with hyphens.",
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "UtcTimestamp": {
      "description": "RFC 3339 UTC instant with Z suffix, millisecond precision.",
      "type": "string",
      "format": "date-time"
    },
    "VmId": {
      "description": "VmId: version 7 UUID, lowercase with hyphens.",
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
