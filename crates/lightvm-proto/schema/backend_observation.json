{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BackendObservation",
  "description": "Elementary event observed by the backend, used by the core to derive the state.",
  "oneOf": [
    {
      "description": "Process created and associated with the run.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "process_spawned"
        },
        "run_id": {
          "description": "Run.",
          "$ref": "#/$defs/RunId"
        }
      },
      "required": [
        "kind",
        "run_id"
      ]
    },
    {
      "description": "QMP ready (capabilities negotiated) and process alive.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "qmp_ready"
        },
        "run_id": {
          "description": "Run.",
          "$ref": "#/$defs/RunId"
        }
      },
      "required": [
        "kind",
        "run_id"
      ]
    },
    {
      "description": "Process end observed through the handle (not through the PID).",
      "type": "object",
      "properties": {
        "expected": {
          "description": "`true` if the exit had been requested (ordinary stop, force-stop, Emergency Stop).",
          "type": "boolean"
        },
        "kind": {
          "type": "string",
          "const": "process_exited"
        },
        "run_id": {
          "description": "Run.",
          "$ref": "#/$defs/RunId"
        }
      },
      "required": [
        "kind",
        "run_id",
        "expected"
      ]
    },
    {
      "description": "Start failed before the process was ready.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "start_failed"
        },
        "run_id": {
          "description": "Run.",
          "$ref": "#/$defs/RunId"
        }
      },
      "required": [
        "kind",
        "run_id"
      ]
    }
  ],
  "$defs": {
    "RunId": {
      "description": "RunId: version 7 UUID, lowercase with hyphens.",
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
