{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResourceLimits",
  "description": "Resource limits (global or per VM). All fields are inclusive maxima.",
  "type": "object",
  "properties": {
    "max_agent_sessions": {
      "description": "Concurrent agent sessions (MVP: 1).",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "max_disk_gib": {
      "description": "Maximum virtual disk per VM in GiB.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "max_memory_mib": {
      "description": "Maximum guest memory per VM in MiB.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "max_running_vms": {
      "description": "Concurrently running VMs (MVP: 1).",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "max_vcpus": {
      "description": "Maximum vCPUs per VM.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "required": [
    "max_vcpus",
    "max_memory_mib",
    "max_disk_gib",
    "max_running_vms",
    "max_agent_sessions"
  ]
}
