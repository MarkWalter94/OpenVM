{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VmRequest",
  "description": "Request for an action on a VM.",
  "type": "object",
  "properties": {
    "action": {
      "description": "Action (object with a `type` discriminant).",
      "$ref": "#/$defs/VmAction"
    },
    "expected_run_id": {
      "description": "Expected run: mandatory for reset, screenshot and input; if present\nand different from the current run the request is rejected (`state_conflict`).",
      "anyOf": [
        {
          "$ref": "#/$defs/RunId"
        },
        {
          "type": "null"
        }
      ]
    },
    "operation_id": {
      "description": "Idempotency key chosen by the caller: the same request repeated with\nthe same `operation_id` does not duplicate the effect.",
      "$ref": "#/$defs/OperationId"
    },
    "vm_id": {
      "description": "VM.",
      "$ref": "#/$defs/VmId"
    }
  },
  "required": [
    "operation_id",
    "vm_id",
    "action"
  ],
  "$defs": {
    "DisplayGeometry": {
      "description": "Guest display geometry in pixels.",
      "type": "object",
      "properties": {
        "height": {
          "description": "Height (1..=8192).",
          "type": "integer",
          "format": "uint32",
          "maximum": 8192,
          "minimum": 1
        },
        "width": {
          "description": "Width (1..=8192).",
          "type": "integer",
          "format": "uint32",
          "maximum": 8192,
          "minimum": 1
        }
      },
      "required": [
        "width",
        "height"
      ]
    },
    "InputBatch": {
      "description": "Batch of input events tied to a run and a geometry: the core\nrejects batches tied to a superseded `run_id` or a non-current geometry\n(ROADMAP 6.4). Inputs are never repeated automatically.",
      "type": "object",
      "properties": {
        "events": {
          "description": "Events, at most [`MAX_INPUT_EVENTS_PER_REQUEST`].",
          "type": "array",
          "items": {
            "$ref": "#/$defs/InputEvent"
          }
        },
        "geometry": {
          "description": "Geometry on which the caller computed the coordinates.",
          "$ref": "#/$defs/DisplayGeometry"
        },
        "run_id": {
          "description": "Expected run.",
          "$ref": "#/$defs/RunId"
        },
        "vm_id": {
          "description": "Target VM.",
          "$ref": "#/$defs/VmId"
        }
      },
      "required": [
        "vm_id",
        "run_id",
        "geometry",
        "events"
      ]
    },
    "InputEvent": {
      "description": "Elementary input event.",
      "oneOf": [
        {
          "description": "Key.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "key"
            }
          },
          "$ref": "#/$defs/KeyAction",
          "required": [
            "type"
          ]
        },
        {
          "description": "Absolute movement.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "pointer_move"
            }
          },
          "$ref": "#/$defs/PointerMove",
          "required": [
            "type"
          ]
        },
        {
          "description": "Button.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "pointer_button"
            }
          },
          "$ref": "#/$defs/PointerButton",
          "required": [
            "type"
          ]
        }
      ]
    },
    "KeyAction": {
      "description": "Press or release of a key.",
      "type": "object",
      "properties": {
        "down": {
          "description": "`true` = pressed, `false` = released.",
          "type": "boolean"
        },
        "qcode": {
          "description": "QEMU key.",
          "$ref": "#/$defs/QCode"
        }
      },
      "required": [
        "qcode",
        "down"
      ]
    },
    "MouseButton": {
      "description": "Pointer button (allowed QMP `InputButton` names).",
      "oneOf": [
        {
          "description": "Left.",
          "type": "string",
          "const": "left"
        },
        {
          "description": "Middle.",
          "type": "string",
          "const": "middle"
        },
        {
          "description": "Right.",
          "type": "string",
          "const": "right"
        },
        {
          "description": "Wheel up.",
          "type": "string",
          "const": "wheel_up"
        },
        {
          "description": "Wheel down.",
          "type": "string",
          "const": "wheel_down"
        }
      ]
    },
    "OperationId": {
      "description": "OperationId: version 7 UUID, lowercase with hyphens.",
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "PointerButton": {
      "description": "Press or release of a pointer button.",
      "type": "object",
      "properties": {
        "button": {
          "description": "Button.",
          "$ref": "#/$defs/MouseButton"
        },
        "down": {
          "description": "`true` = pressed, `false` = released.",
          "type": "boolean"
        }
      },
      "required": [
        "button",
        "down"
      ]
    },
    "PointerMove": {
      "description": "Absolute pointer movement in QEMU coordinates 0..=32767 on each axis.",
      "type": "object",
      "properties": {
        "x": {
          "description": "X axis (0..=32767).",
          "type": "integer",
          "format": "uint16",
          "maximum": 32767,
          "minimum": 0
        },
        "y": {
          "description": "Y axis (0..=32767).",
          "type": "integer",
          "format": "uint16",
          "maximum": 32767,
          "minimum": 0
        }
      },
      "required": [
        "x",
        "y"
      ]
    },
    "QCode": {
      "description": "QEMU QKeyCode.",
      "type": "string",
      "pattern": "^[a-z0-9_]{1,32}$"
    },
    "RunId": {
      "description": "RunId: version 7 UUID, lowercase with hyphens.",
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "VmAction": {
      "description": "Action requested on an existing VM.",
      "oneOf": [
        {
          "description": "Start.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "start"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "Ordinary stop.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "stop"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "Forced stop with OS primitives.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "force_stop"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "Guest reset.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "reset"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "Screenshot.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "screenshot"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "description": "Typed input.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "input"
            }
          },
          "$ref": "#/$defs/InputBatch",
          "required": [
            "type"
          ]
        }
      ]
    },
    "VmId": {
      "description": "VmId: version 7 UUID, lowercase with hyphens.",
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
