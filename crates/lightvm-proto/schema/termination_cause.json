{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TerminationCause",
  "description": "Termination cause of a session (recorded in the report, ROADMAP 9).",
  "oneOf": [
    {
      "description": "Ordinary close from the app.",
      "type": "string",
      "const": "completed"
    },
    {
      "description": "Revoked by the user.",
      "type": "string",
      "const": "revoked"
    },
    {
      "description": "Emergency Stop.",
      "type": "string",
      "const": "emergency_stop"
    },
    {
      "description": "Grant expired.",
      "type": "string",
      "const": "grant_expired"
    },
    {
      "description": "Lease not renewed within the limit.",
      "type": "string",
      "const": "lease_expired"
    },
    {
      "description": "Loss of the client or of the adapter.",
      "type": "string",
      "const": "client_lost"
    },
    {
      "description": "UI closed or crashed.",
      "type": "string",
      "const": "ui_closed"
    },
    {
      "description": "Supervisor lost or restarted.",
      "type": "string",
      "const": "supervisor_lost"
    },
    {
      "description": "Host resumed from sleep.",
      "type": "string",
      "const": "host_resumed"
    },
    {
      "description": "VM failed or terminated during the session.",
      "type": "string",
      "const": "vm_terminated"
    },
    {
      "description": "Baseline restore: the control session closes (ROADMAP 8).",
      "type": "string",
      "const": "restored"
    }
  ]
}
