{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Capability",
  "description": "Authorizable action on a VM. Serialized names follow the MCP catalog\n(ROADMAP 9); `vm.input` covers mouse and keyboard.",
  "oneOf": [
    {
      "description": "List filtered by the grant.",
      "type": "string",
      "const": "vm.list"
    },
    {
      "description": "Status.",
      "type": "string",
      "const": "vm.status"
    },
    {
      "description": "Start.",
      "type": "string",
      "const": "vm.start"
    },
    {
      "description": "Stop (ordinary or forced).",
      "type": "string",
      "const": "vm.stop"
    },
    {
      "description": "Reset: requires an explicit capability.",
      "type": "string",
      "const": "vm.reset"
    },
    {
      "description": "Screenshot.",
      "type": "string",
      "const": "vm.screenshot"
    },
    {
      "description": "Mouse and keyboard.",
      "type": "string",
      "const": "vm.input"
    },
    {
      "description": "Checkpoint with the VM off: requires an explicit capability.",
      "type": "string",
      "const": "vm.snapshot"
    },
    {
      "description": "Restore with the VM off.",
      "type": "string",
      "const": "vm.restore"
    },
    {
      "description": "Authorized LightVM events and QEMU logs.",
      "type": "string",
      "const": "vm.logs"
    }
  ]
}
