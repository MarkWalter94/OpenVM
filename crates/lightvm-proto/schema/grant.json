{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Grant",
  "description": "Grant issued by the supervisor after the user's approval in the app (ROADMAP 9).",
  "type": "object",
  "properties": {
    "capabilities": {
      "description": "Granted capabilities.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Capability"
      },
      "uniqueItems": true
    },
    "expires_at": {
      "description": "Absolute UTC expiry.",
      "$ref": "#/$defs/UtcTimestamp"
    },
    "id": {
      "description": "Identifier.",
      "$ref": "#/$defs/GrantId"
    },
    "network_endpoints": {
      "description": "Network endpoints of the VM the session may use (names as in the VM\nsettings, normalized to lower case), with\n[`Capability::NetworkEndpoints`]; empty otherwise (ADR-0033).",
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "policy_revision": {
      "description": "Revision of the policy the grant was issued with.",
      "$ref": "#/$defs/PolicyRevision"
    },
    "quotas": {
      "description": "Granted quotas.",
      "$ref": "#/$defs/Quotas"
    },
    "session_id": {
      "description": "Session it is bound to.",
      "$ref": "#/$defs/SessionId"
    },
    "tools": {
      "$ref": "#/$defs/ToolGrant"
    },
    "vm_allowlist": {
      "description": "Allowed VMs (explicit allowlist; empty = no VM).",
      "type": "array",
      "items": {
        "$ref": "#/$defs/VmId"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "id",
    "session_id",
    "vm_allowlist",
    "capabilities",
    "expires_at",
    "quotas",
    "policy_revision"
  ],
  "$defs": {
    "Capability": {
      "description": "Authorizable action on a VM. Serialized names follow the MCP catalog\n(ROADMAP 9); `vm.input` covers mouse and keyboard.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "share.read",
            "share.write",
            "clipboard",
            "files.transfer",
            "usb",
            "ui.inspect",
            "ui.act",
            "guest.exec"
          ]
        },
        {
          "description": "List filtered by the grant.",
          "type": "string",
          "const": "vm.list"
        },
        {
          "description": "Status.",
          "type": "string",
          "const": "vm.status"
        },
        {
          "description": "Start.",
          "type": "string",
          "const": "vm.start"
        },
        {
          "description": "Stop (ordinary or forced).",
          "type": "string",
          "const": "vm.stop"
        },
        {
          "description": "Reset: requires an explicit capability.",
          "type": "string",
          "const": "vm.reset"
        },
        {
          "description": "Screenshot.",
          "type": "string",
          "const": "vm.screenshot"
        },
        {
          "description": "Mouse and keyboard.",
          "type": "string",
          "const": "vm.input"
        },
        {
          "description": "Checkpoint with the VM off: requires an explicit capability.",
          "type": "string",
          "const": "vm.snapshot"
        },
        {
          "description": "Restore with the VM off.",
          "type": "string",
          "const": "vm.restore"
        },
        {
          "description": "Authorized LightVM events and QEMU logs.",
          "type": "string",
          "const": "vm.logs"
        },
        {
          "description": "Network endpoints of the VM's allowlist (ADR-0033, ADR-0034): the\ngrant lists which ones ([`Grant::network_endpoints`]). Without it\nthe session's VM runs without network.",
          "type": "string",
          "const": "network.endpoints"
        }
      ]
    },
    "GrantId": {
      "description": "GrantId: version 7 UUID, lowercase with hyphens.",
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "PolicyRevision": {
      "description": "Monotonic revision of the applied policy (recorded in reports, ROADMAP 9).",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "Quotas": {
      "description": "Quotas of a session or of a policy layer. Each field is an inclusive\nmaximum; the intersection takes the minimum.",
      "type": "object",
      "properties": {
        "max_input_events": {
          "description": "Total input events allowed in the session.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "max_operations": {
          "description": "Total operations allowed in the session.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "max_queued_operations": {
          "description": "Operations queued per VM and not yet forwarded.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "max_screenshot_bytes": {
          "description": "Maximum size of a single screenshot in bytes.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "max_screenshots": {
          "description": "Total screenshots allowed in the session.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "max_operations",
        "max_input_events",
        "max_screenshots",
        "max_screenshot_bytes",
        "max_queued_operations"
      ]
    },
    "SessionId": {
      "description": "SessionId: version 7 UUID, lowercase with hyphens.",
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "ToolGrant": {
      "description": "Named subsets granted by the user. Booleans in `shares` denote write\npermission; feature capabilities remain independently required.",
      "type": "object",
      "properties": {
        "shares": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "usb_devices": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "UtcTimestamp": {
      "description": "RFC 3339 UTC instant with Z suffix, millisecond precision.",
      "type": "string",
      "format": "date-time"
    },
    "VmId": {
      "description": "VmId: version 7 UUID, lowercase with hyphens.",
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
